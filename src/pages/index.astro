---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { SITE, PROJECTS, href } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<BaseLayout>
	<section class="hero">
		<p class="eyebrow"><span class="dot"></span>Currently building</p>
		<h1>Small, sharp tools for the desktop and the agent era.</h1>
		<p class="serif-note tagline">{SITE.tagline}</p>
	</section>

	<hr class="rule" />

	<section>
		<div class="section-head">
			<h2>Writing</h2>
			<a class="more" href={href('/writing/')}>All posts →</a>
		</div>
		{
			posts.length > 0 ? (
				<PostList posts={posts} />
			) : (
				<p class="serif-note">Nothing published yet.</p>
			)
		}
	</section>

	<hr class="rule" />

	<section>
		<h2>Projects</h2>
		<ul class="projects">
			{
				PROJECTS.map((project) => (
					<li>
						<h3 class="name">
							{project.href ? <a href={project.href}>{project.name}</a> : project.name}
						</h3>
						<p class="stack">{project.stack}</p>
						<p class="desc">{project.description}</p>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.hero {
		max-width: 38rem;
	}

	.hero h1 {
		margin-bottom: 0.9rem;
	}

	.tagline {
		max-width: 30rem;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.6rem;
	}

	.section-head h2 {
		margin: 0;
	}

	.more {
		font-size: 0.85rem;
		text-decoration: none;
	}

	.more:hover {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 0.2em;
	}

	.projects {
		display: grid;
		gap: 1.9rem;
		margin: 1.6rem 0 0;
		padding: 0;
		list-style: none;
	}

	.projects li {
		display: grid;
		grid-template-columns: 7.25rem 1fr;
		column-gap: 1.5rem;
	}

	.name {
		grid-column: 2;
		margin: 0 0 0.22rem;
		font-size: 1.115rem;
		letter-spacing: -0.015em;
	}

	.name a {
		color: var(--ink);
		text-decoration: none;
	}

	.name a:hover {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 1.5px;
		text-underline-offset: 0.2em;
	}

	.stack {
		grid-column: 1;
		grid-row: 1 / span 2;
		padding-top: 0.4rem;
		margin: 0;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		line-height: 1.5;
		letter-spacing: 0.01em;
	}

	.desc {
		grid-column: 2;
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.925rem;
		line-height: 1.62;
	}

	@media (max-width: 34rem) {
		.projects li {
			grid-template-columns: 1fr;
		}

		.stack {
			grid-row: auto;
			padding-top: 0;
			margin-bottom: 0.3rem;
		}

		.name,
		.desc {
			grid-column: 1;
		}
	}
</style>

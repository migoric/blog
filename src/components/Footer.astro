---
import { SITE, LINKS, href } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap">
		<p class="fine">
			© {year} {SITE.author}
			<span class="sep" aria-hidden="true">·</span>
			<a href={href('/rss.xml')}>RSS</a>
			<span class="sep" aria-hidden="true">·</span>
			<a href={href('/about/')}>About</a>
		</p>
		<ul class="elsewhere">
			{
				LINKS.map((link) => (
					<li>
						<a href={link.href}>{link.label}</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 5rem;
		padding-block: 1.75rem 2.75rem;
		border-top: 1px solid var(--rule);
	}

	.wrap {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
	}

	.fine {
		margin: 0;
		color: var(--muted);
		font-size: 0.82rem;
	}

	.fine a {
		color: var(--muted);
		text-decoration-color: color-mix(in srgb, var(--muted) 45%, transparent);
	}

	.fine a:hover {
		color: var(--ink);
	}

	.sep {
		margin-inline: 0.35em;
	}

	.elsewhere {
		display: flex;
		flex-wrap: wrap;
		gap: 1.1rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.82rem;
	}

	.elsewhere a {
		color: var(--muted);
		text-decoration: none;
	}

	.elsewhere a:hover {
		color: var(--accent-ink);
		text-decoration: underline;
	}
</style>

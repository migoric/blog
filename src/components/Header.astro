---
import HeaderLink from './HeaderLink.astro';
import { SITE, NAV, href } from '../consts';
---

<header class="site-header">
	<div class="wrap bar">
		<a class="brand" href={href('/')}>
			<span class="mark" aria-hidden="true"></span>
			{SITE.title}
		</a>
		<nav aria-label="Primary">
			{NAV.map((item) => <HeaderLink href={href(item.href)}>{item.label}</HeaderLink>)}
		</nav>
	</div>
</header>

<style>
	.site-header {
		background: var(--paper);
		border-bottom: 1px solid var(--rule);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		min-height: 3.9rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--ink);
		font-weight: 600;
		letter-spacing: -0.015em;
		text-decoration: none;
	}

	.mark {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 1px;
		background: var(--accent);
	}

	nav {
		display: flex;
		gap: clamp(0.9rem, 3vw, 1.6rem);
	}

	/* HeaderLink renders the <a> from another component, so its scope differs
	   from this one — hence :global(). */
	nav :global(a) {
		padding-block: 0.25rem;
		border-bottom: 1.5px solid transparent;
		color: var(--muted);
		font-size: 0.9rem;
		text-decoration: none;
		transition: color 0.15s ease, border-color 0.15s ease;
	}

	nav :global(a:hover) {
		color: var(--ink);
	}

	nav :global(a.active) {
		border-bottom-color: var(--accent);
		color: var(--ink);
	}
</style>
